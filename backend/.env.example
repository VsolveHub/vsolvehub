# Copy to backend/.env for local development. Only the first block is needed: every other setting
# already has a working local default in config/settings/local.py and base.py, so add a key only
# to override one. Paste real secrets into backend/.env only, never into this file.
#
# Production does not use this file. Set values in the host's environment;
# config/settings/production.py refuses to start until each required one is present.

# --- Needed locally -----------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
# Turns a map pin into an address (Google Geocoding API). A server key restricted to the
# Geocoding API, never the browser key. Without it, address lookup from a pin fails.
GOOGLE_MAPS_SERVER_KEY=

# Postgres and Redis default to the ports in infra/compose.yaml. Uncomment only if yours differ.
# DATABASE_URL=postgresql://vsolve:vsolve-local-only@127.0.0.1:15432/vsolve
# REDIS_URL=redis://127.0.0.1:56379/0
# CELERY_BROKER_URL=redis://127.0.0.1:56379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/2

# --- Firebase phone login -----------------------------------------------------
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
# Optional service-account JSON (one line). Not needed just to verify login tokens.
# FIREBASE_CREDENTIALS_JSON=

# --- Payments: Razorpay test mode, required locally -----------------------------
# Every payment opens Razorpay Checkout; there is no "mark as paid" shortcut. Use test-mode keys
# (rzp_test_...). The webhook secret is a separate value from the key secret. The Celery worker
# must run: it creates the Razorpay order a payment opens with.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Optional: real providers in local development ----------------------------
# Locally, login OTPs and notification sending use fakes. Uncomment a block to try the real
# provider.

# RazorpayX payouts, test mode. Separate keys from collections above. Local settings refuse
# rzp_live_ keys. PAYOUTS_LIVE_ENABLED is required even for test keys (test mode moves only
# dummy money). Payouts are sent by the Celery worker, so run one. A cooling period of 0 makes a
# verified bank account payable at once; production refuses anything under 24 hours.
# RAZORPAYX_ACCOUNT_NUMBER is your RazorpayX business account number from the test-mode
# dashboard, not a partner's bank account. The webhook (payout.* events) goes to
# https://<tunnel>/api/v1/payout-webhooks/razorpayx/ with the same secret as here.
# PAYOUT_PROVIDER=razorpayx
# PAYOUTS_LIVE_ENABLED=true
# PAYOUTS_ALLOW_FAKE_PROVIDER=false
# RAZORPAYX_KEY_ID=rzp_test_
# RAZORPAYX_KEY_SECRET=
# RAZORPAYX_ACCOUNT_NUMBER=
# RAZORPAYX_WEBHOOK_SECRET=
# PAYOUT_ACCOUNT_COOLING_HOURS=0

# MSG91: login OTP by SMS, and the notification SMS (notifications/channel_plan.py).
# OTP_PROVIDER=msg91
# MESSAGE_TRANSPORT=msg91
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=
# Notification SMS: off until the 7 templates are DLT-registered and created in MSG91.
# `python manage.py channel_templates --channel sms` prints their text and this JSON's keys.
# SMS_NOTIFICATIONS_ENABLED=false
# MSG91_TEMPLATE_IDS={"customer_visit_arrived":"<msg91 template id>", ...}

# WhatsApp notifications through Meta's Cloud API (notifications/whatsapp.py). Off until the
# templates are approved: `python manage.py channel_templates --channel whatsapp` prints them.
# Check the keys with `python manage.py send_test_message --channel whatsapp --to +91...`.
# WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=        # Meta app -> WhatsApp -> API Setup -> Phone number ID
# WHATSAPP_ACCESS_TOKEN=           # System user token, never-expiring. Keep it only here.
# WHATSAPP_TEMPLATE_LANGUAGE=en    # en_US if the templates were created as "English (US)"
# WHATSAPP_GRAPH_API_VERSION=v23.0
# Status webhook: https://<api host>/api/v1/notification-webhooks/whatsapp/ in the Meta app.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=   # any string; type the same one into Meta's webhook setup
# WHATSAPP_APP_SECRET=             # Meta app -> App settings -> Basic -> App secret

# Cloudflare R2 file storage (docs/runbooks/cloudflare-r2-storage.md). Without it, photos are
# kept on this machine's disk and private uploads such as partner KYC documents are refused.
# DOCUMENT_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=
# R2_PUBLIC_BASE_URL=
# R2_PRIVATE_BUCKET=

# Partner site origin: its /terms and /privacy become the agreements applicants accept.
# Leave empty locally to use placeholder agreements at a .test host. Required in production.
PARTNER_LEGAL_BASE_URL=

# Customer site origin; referral share links are built on it (/signup?ref=CODE).
# Defaults to http://localhost:3000 locally. Required (https) in production.
CUSTOMER_SITE_URL=http://localhost:3000

# OneSignal push: one app per audience, shared by its website and mobile app. No shared App ID or
# key, and no fallback between them.
# ONESIGNAL_PARTNER_APP_ID=
# ONESIGNAL_PARTNER_REST_API_KEY=
# ONESIGNAL_CUSTOMER_APP_ID=
# ONESIGNAL_CUSTOMER_REST_API_KEY=
# ONESIGNAL_PARTNER_OFFER_CHANNEL_ID=
# ONESIGNAL_ENV=local|production
# MOBILE_PUSH_PROVIDER=onesignal
# DISPATCH_OFFER_EXPIRY_SECONDS=60
# FEATURE_PUSH_GATED_INSTANT=false
# PARTNER_SHIFT_DEFAULT_DURATION_HOURS=8
# PARTNER_SHIFT_MAX_IDLE_MINUTES=30
# PARTNER_LOCATION_MAX_AGE_MINUTES=30
# MAX_DISPATCH_ATTEMPTS=5
# MAX_CONSECUTIVE_MISSED_OFFERS=3

