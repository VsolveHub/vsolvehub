DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
CORS_EXPOSE_HEADERS=Date
DATABASE_URL=postgresql://vsolve:vsolve-local-only@127.0.0.1:15432/vsolve
REDIS_URL=redis://127.0.0.1:56379/0
CELERY_BROKER_URL=redis://127.0.0.1:56379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/2
CELERY_TASK_TIME_LIMIT_SECONDS=60
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=45
LOG_LEVEL=INFO
API_DOCS_ENABLED=true
SECURE_HSTS_SECONDS=0
FINANCE_STEP_UP_TTL_SECONDS=600
GEOCODING_PROVIDER=nominatim
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=VsolveHub/0.1 (your-production-contact)
GEOCODING_TIMEOUT_SECONDS=3
GEOCODING_CACHE_SECONDS=604800
GEOCODING_CACHE_COORDINATE_PRECISION=5
DOCUMENT_STORAGE_PROVIDER=unconfigured
# Cloudflare R2. Leave blank locally to keep files on disk.
# Dashboard locations: docs/runbooks/cloudflare-r2-storage.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BUCKET=
R2_PRIVATE_URL_TTL_SECONDS=300
SUPABASE_STORAGE_URL=https://your-project-ref.storage.supabase.co/storage/v1
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
PARTNER_DOCUMENT_BUCKET=partner-kyc
DOCUMENT_STORAGE_CONNECT_TIMEOUT_SECONDS=3
DOCUMENT_STORAGE_READ_TIMEOUT_SECONDS=15
PARTNER_DOCUMENT_REVIEW_URL_TTL_SECONDS=300
PARTNER_DOCUMENT_ORPHAN_RETENTION_HOURS=24
PARTNER_PRESENCE_TTL_SECONDS=90
PARTNER_PRESENCE_DB_TOUCH_SECONDS=300
PARTNER_LOCATION_MAX_ACCURACY_METERS=500
PARTNER_LOCATION_STALE_SECONDS=1800
CELERY_INTEGRATION_BROKER_URL=redis://127.0.0.1:56379/11
CELERY_INTEGRATION_RESULT_BACKEND=redis://127.0.0.1:56379/12
OUTBOX_LEASE_SECONDS=120
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BACKOFF_SECONDS=30
OUTBOX_RETRY_BACKOFF_MAX_SECONDS=900
OUTBOX_RECOVERY_BATCH_SIZE=200

# =============================================================================================
# SMS / OTP — MSG91
# Local demo (no keys): OTP_PROVIDER=development shows the code on the login screen.
# To test real SMS: fill the three MSG91 values, then set OTP_PROVIDER=msg91 and
# OTP_DEVELOPMENT_CODE_ENABLED=false. With msg91 selected but keys empty, login refuses (fail closed).
# Paste real values into backend/.env only — never commit them.
# =============================================================================================
OTP_PROVIDER=development
OTP_DEVELOPMENT_CODE_ENABLED=true
# MSG91 → API → Authkey
MSG91_AUTH_KEY=
# DLT-approved sender id (6 letters), e.g. VSOLVE
MSG91_SENDER_ID=
# MSG91 → OTP → template id (DLT-approved OTP template)
MSG91_OTP_TEMPLATE_ID=
MSG91_API_BASE_URL=https://control.msg91.com/api/v5
# Other SMS/WhatsApp notifications (booking updates, reminders).
# unconfigured = refuse to send · fake = pretend-send locally (log only) · msg91 = real send.
MESSAGE_TRANSPORT=fake
NOTIFICATIONS_ALLOW_FAKE_TRANSPORT=true

# =============================================================================================
# Customer payments — Razorpay (use TEST MODE keys: rzp_test_…)
# Local demo (no keys): PAYMENT_PROVIDER=fake with simulated capture.
# To test Razorpay Checkout: fill the key id/secret and webhook secret, set
# PAYMENT_PROVIDER=razorpay and PAYMENTS_ALLOW_SIMULATED_CAPTURE=false.
# The browser receives the public key id from Django per payment; no frontend variable needed.
# =============================================================================================
PAYMENT_PROVIDER=fake
# Development only; production refuses it. Lets the apps mark fake payments captured.
PAYMENTS_ALLOW_SIMULATED_CAPTURE=true
# Razorpay Dashboard (Test Mode) → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard (Test Mode) → Webhooks → the secret YOU typed when creating the webhook.
# Not the Key Secret. Webhook URL: https://<your-ngrok-host>/api/v1/payment-webhooks/razorpay/
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
PAYMENT_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PAYMENT_PROVIDER_READ_TIMEOUT_SECONDS=10
PAYMENT_LEGAL_ENTITY_CODE=vsolve
# Stays false while testing. Only true once live (rzp_live_…) collections are approved.
PAYMENT_LIVE_COLLECTIONS_APPROVED=false

# =============================================================================================
# Partner payouts — RazorpayX (separate keys from collections on purpose)
# Local demo: PAYOUT_PROVIDER=fake. To test RazorpayX: fill the values below and set
# PAYOUT_PROVIDER=razorpayx. Real money only moves when PAYOUTS_LIVE_ENABLED=true — keep false.
# =============================================================================================
PAYOUT_PROVIDER=fake
PAYOUTS_ALLOW_FAKE_PROVIDER=true
PAYOUTS_LIVE_ENABLED=false
RAZORPAYX_API_BASE_URL=https://api.razorpay.com/v1
# RazorpayX Dashboard (Test Mode) → Settings → API Keys
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# RazorpayX → Banking → your account number (the test account in Test Mode)
RAZORPAYX_ACCOUNT_NUMBER=
# Optional for now: payout status is checked by the reconciliation sweep, and no RazorpayX
# webhook route is wired yet. Fill it when that route is added.
RAZORPAYX_WEBHOOK_SECRET=
