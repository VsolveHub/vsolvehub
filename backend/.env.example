# Copy to backend/.env for local development. Only the first block is needed: every other setting
# already has a working local default in config/settings/local.py and base.py, so add a key only
# to override one. Paste real secrets into backend/.env only, never into this file.
#
# Production does not use this file. Set values in the host's environment;
# config/settings/production.py refuses to start until each required one is present.

# --- Needed locally -----------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
# Turns a map pin into an address (Google Geocoding API). A server key restricted to the
# Geocoding API, never the browser key. Without it, address lookup from a pin fails.
GOOGLE_MAPS_SERVER_KEY=

# Postgres and Redis default to the ports in infra/compose.yaml. Uncomment only if yours differ.
# DATABASE_URL=postgresql://vsolve:vsolve-local-only@127.0.0.1:15432/vsolve
# REDIS_URL=redis://127.0.0.1:56379/0
# CELERY_BROKER_URL=redis://127.0.0.1:56379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/2

# --- Firebase phone login -----------------------------------------------------
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
# Optional service-account JSON (one line). Not needed just to verify login tokens.
# FIREBASE_CREDENTIALS_JSON=

# --- Optional: real providers in local development ----------------------------
# Locally, payments, login OTPs and notification sending all use fakes. Uncomment a block to try
# the real provider.

# Razorpay test mode. The webhook secret is a separate value from the key secret.
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# MSG91: login OTP by SMS, and the SMS/WhatsApp notification transport.
# OTP_PROVIDER=msg91
# MESSAGE_TRANSPORT=msg91
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=

# Cloudflare R2 file storage (docs/runbooks/cloudflare-r2-storage.md). Without it, photos are
# kept on this machine's disk and private uploads such as partner KYC documents are refused.
# DOCUMENT_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=
# R2_PUBLIC_BASE_URL=
# R2_PRIVATE_BUCKET=
