{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "partner",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "--filter", "partner", "dev"],
      "port": 3001
    },
    {
      "name": "customer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "--filter", "customer", "dev"],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "--filter", "admin", "dev"],
      "port": 3002
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/python",
      "runtimeArgs": ["backend/manage.py", "runserver", "0.0.0.0:8000"],
      "port": 8000
    }
  ]
}
