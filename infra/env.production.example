# Copy to infra/.env.production on the server, fill it in, then: chmod 600 infra/.env.production
# Never commit the real file (git ignores it). Every key here is read by backend/config/settings.
# config/settings/production.py refuses to start if a required value is missing or unsafe.
#
# [R] required   [S] secret   Everything not listed has a working default in config/settings/.

# --- Compose: the Postgres container ---
POSTGRES_PASSWORD=                      # [R][S] openssl rand -hex 32

# --- Django ---
DJANGO_SECRET_KEY=                      # [R][S] 50+ chars: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=api.vsolvehub.com  # [R]
CORS_ALLOWED_ORIGINS=https://www.vsolvehub.com,https://vsolvehub.com,https://partner.vsolvehub.com,https://admin.vsolvehub.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.vsolvehub.com,https://vsolvehub.com,https://partner.vsolvehub.com,https://admin.vsolvehub.com
# SECURE_HSTS_SECONDS=3600              # raise to 31536000 after a stable week
# SESSION_COOKIE_DOMAIN and CSRF_COOKIE_DOMAIN must stay unset.

# --- Database, Redis, Celery (service names from infra/compose.production.yaml) ---
# Repeat POSTGRES_PASSWORD literally: env files do not expand ${...}.
DATABASE_URL=postgresql://vsolve:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/vsolve   # [R][S]
REDIS_URL=redis://redis:6379/0          # [R]
CELERY_BROKER_URL=redis://redis:6379/1  # [R]
CELERY_RESULT_BACKEND=redis://redis:6379/2  # [R]
# WEB_CONCURRENCY=2  GUNICORN_THREADS=32  # each open partner app holds one thread

# --- Customer and partner login: Firebase ---
FIREBASE_AUTH_ENABLED=true              # [R]
FIREBASE_PROJECT_ID=v-solve-hub         # [R]

# --- Operations login and refund step-up: backend OTP over MSG91 ---
# The Operations app cannot sign in without these. "development" is refused in production.
OTP_PROVIDER=msg91                      # [R]
MSG91_AUTH_KEY=                         # [R][S]
MSG91_OTP_TEMPLATE_ID=                  # [R] DLT-approved OTP template
MSG91_SENDER_ID=                        # [R]

# --- Notifications: nothing sends SMS yet; "fake" is refused in production ---
MESSAGE_TRANSPORT=unconfigured

# --- Payments: Razorpay. Start with Test Mode keys (rzp_test_...) ---
PAYMENT_PROVIDER=razorpay               # [R]
RAZORPAY_KEY_ID=                        # [R] rzp_test_... for the beta, rzp_live_... later
RAZORPAY_KEY_SECRET=                    # [R][S]
PAYMENT_WEBHOOK_SECRET=                 # [R][S] 32+ chars; the same value goes into Razorpay -> Webhooks
# Required for the settings to load. With test keys no real money moves; get CA/legal sign-off
# before switching to live keys.
PAYMENT_LIVE_COLLECTIONS_APPROVED=true

# --- Payouts: RazorpayX stays OFF for the beta ---
# With PAYOUT_PROVIDER=unconfigured, partners cannot add bank accounts. To collect them while
# payouts stay off, set PAYOUT_PROVIDER=razorpayx with RAZORPAYX_KEY_ID, RAZORPAYX_KEY_SECRET,
# RAZORPAYX_ACCOUNT_NUMBER and a 32+ char RAZORPAYX_WEBHOOK_SECRET, and keep
# PAYOUTS_LIVE_ENABLED=false: registering an account moves no money. Accounts registered with
# test keys do not exist in live mode, so partners re-enter them after switching to live keys.
PAYOUT_PROVIDER=unconfigured
PAYOUTS_LIVE_ENABLED=false

# --- Files: Cloudflare R2 (docs/runbooks/cloudflare-r2-storage.md) ---
DOCUMENT_STORAGE_PROVIDER=r2            # [R]
R2_ACCOUNT_ID=                          # [R]
R2_ACCESS_KEY_ID=                       # [R][S]
R2_SECRET_ACCESS_KEY=                   # [R][S]
R2_PUBLIC_BUCKET=vsolve-public          # [R]
R2_PUBLIC_BASE_URL=https://media.vsolvehub.com   # [R] https
R2_PRIVATE_BUCKET=vsolve-private        # [R] must differ from the public bucket

# --- Geocoding ---
GEOCODING_PROVIDER=nominatim            # [R]
GEOCODING_USER_AGENT="VsolveHub/1.0 (support@vsolvehub.com)"   # [R] a real contact

# --- Must stay off in production (the settings refuse to start otherwise) ---
# OTP_DEVELOPMENT_CODE_ENABLED=false
# PAYMENTS_ALLOW_SIMULATED_CAPTURE=false
# NOTIFICATIONS_ALLOW_FAKE_TRANSPORT=false
# PAYOUTS_ALLOW_FAKE_PROVIDER=false
