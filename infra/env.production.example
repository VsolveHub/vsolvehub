# Copy to infra/.env.production on the server, fill it in, then: chmod 600 infra/.env.production
# Never commit the real file (git ignores it). Every key here is read by backend/config/settings.
# config/settings/production.py refuses to start if a required value is missing or unsafe.
#
# [R] required   [S] secret   Everything not listed has a working default in config/settings/.

# --- Compose: the Postgres container ---
POSTGRES_PASSWORD=                      # [R][S] openssl rand -hex 32

# --- Django ---
DJANGO_SECRET_KEY=                      # [R][S] 50+ chars: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=api.vsolvehub.com  # [R]
CORS_ALLOWED_ORIGINS=https://www.vsolvehub.com,https://vsolvehub.com,https://partner.vsolvehub.com,https://admin.vsolvehub.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.vsolvehub.com,https://vsolvehub.com,https://partner.vsolvehub.com,https://admin.vsolvehub.com
# SECURE_HSTS_SECONDS=3600              # raise to 31536000 after a stable week
# SESSION_COOKIE_DOMAIN and CSRF_COOKIE_DOMAIN must stay unset.

# --- Database, Redis, Celery (service names from infra/compose.production.yaml) ---
# Repeat POSTGRES_PASSWORD literally: env files do not expand ${...}.
DATABASE_URL=postgresql://vsolve:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/vsolve   # [R][S]
REDIS_URL=redis://redis:6379/0          # [R]
CELERY_BROKER_URL=redis://redis:6379/1  # [R]
CELERY_RESULT_BACKEND=redis://redis:6379/2  # [R]
# WEB_CONCURRENCY=2  GUNICORN_THREADS=32  # each open partner app holds one thread

# --- Login: Firebase, for customers, partners and Operations (incl. refund step-up) ---
FIREBASE_AUTH_ENABLED=true              # [R]
FIREBASE_PROJECT_ID=v-solve-hub         # [R]

# --- Sign-in OTP over MSG91 (every app uses NEXT_PUBLIC_PHONE_AUTH_PROVIDER=otp) ---
# "development" is refused in production; msg91 refuses to start without its keys. Codes go to
# Indian (+91) numbers only. Use a production MSG91 key with this server's IP whitelisted.
OTP_PROVIDER=msg91                      # [R]
MSG91_AUTH_KEY=                         # [R][S]
MSG91_OTP_TEMPLATE_ID=                  # [R] MSG91's id for the DLT-approved login OTP template
MSG91_SENDER_ID=VSLHBP                  # [R] the DLT header
# Proxies in front of Django (Caddy = 1). The OTP limits per visitor IP read X-Forwarded-For
# through this many hops; production refuses 0. Add one if a CDN such as Cloudflare sits in front.
# TRUSTED_PROXY_COUNT=1
# MSG91_START_OTP_TEMPLATE_ID=          # [O] visit start code by SMS; unset, it shows in the app only

# --- Notification SMS over MSG91. "fake" is refused in production. ---
# The MSG91 key above must be a production key with this server's IP whitelisted in MSG91, and
# the DLT entity bound to MSG91's telemarketer (PE-TM chain). A notice whose code has no id in
# MSG91_TEMPLATE_IDS is skipped, never sent with other text; `manage.py channel_templates` lists them.
MESSAGE_TRANSPORT=unconfigured
# MESSAGE_TRANSPORT=msg91
# SMS_NOTIFICATIONS_ENABLED=true
# MSG91_TEMPLATE_IDS={"customer_visit_en_route":"<msg91 id>","customer_visit_arrived":"<msg91 id>",...}

# --- WhatsApp Cloud API (Meta). Production refuses WHATSAPP_ENABLED without token and number. ---
# Use a permanent System User token, not the 24-hour one from the API setup page. Webhook:
# https://api.vsolvehub.com/api/v1/notification-webhooks/whatsapp/ with the verify token below.
# WHATSAPP_ENABLED=true
# WHATSAPP_ACCESS_TOKEN=                # [S] permanent System User token
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=        # [S] any long random string, same value in Meta
# WHATSAPP_APP_SECRET=                  # [S] Meta app secret, verifies webhook signatures

# --- Payments: Razorpay. Start with Test Mode keys (rzp_test_...) ---
PAYMENT_PROVIDER=razorpay               # [R]
RAZORPAY_KEY_ID=                        # [R] rzp_test_... for the beta, rzp_live_... later
RAZORPAY_KEY_SECRET=                    # [R][S]
PAYMENT_WEBHOOK_SECRET=                 # [R][S] 32+ chars; the same value goes into Razorpay -> Webhooks
# Required for the settings to load. With test keys no real money moves; get CA/legal sign-off
# before switching to live keys.
PAYMENT_LIVE_COLLECTIONS_APPROVED=true

# --- Customer receipts: who issues them ---
# Leave the address and GSTIN empty until they are real. Without a GSTIN every booking document is a
# "Payment receipt" with no tax lines; setting it (after GST registration) makes it a "Tax invoice".
# Copy the legal name and address exactly as on the registration certificate.
# DOCUMENT_ISSUER_NAME=V Solve Hub
# DOCUMENT_ISSUER_ADDRESS=
# DOCUMENT_ISSUER_GSTIN=

# --- Payouts: RazorpayX stays OFF for the beta ---
# With PAYOUT_PROVIDER=unconfigured, partners cannot add bank accounts. To collect them while
# payouts stay off, set PAYOUT_PROVIDER=razorpayx with RAZORPAYX_KEY_ID, RAZORPAYX_KEY_SECRET,
# RAZORPAYX_ACCOUNT_NUMBER and a 32+ char RAZORPAYX_WEBHOOK_SECRET, and keep
# PAYOUTS_LIVE_ENABLED=false: registering an account moves no money. Accounts registered with
# test keys do not exist in live mode, so partners re-enter them after switching to live keys.
# Cashfree instead: PAYOUT_PROVIDER=cashfree with the Production CASHFREE_PAYOUT_CLIENT_ID and
# CASHFREE_PAYOUT_CLIENT_SECRET, CASHFREE_PAYOUT_API_BASE_URL=https://api.cashfree.com/payout,
# and this server's IP whitelisted in Cashfree (or CASHFREE_PAYOUT_PUBLIC_KEY). Webhook V2 URL:
# https://<api host>/api/v1/payout-webhooks/cashfree/. Bank accounts registered under one
# provider do not exist at the other, so partners re-enter them after switching.
PAYOUT_PROVIDER=unconfigured
PAYOUTS_LIVE_ENABLED=false
# Hours a new or changed bank account waits before it can be paid. Default 24; production refuses
# less. Only a RazorpayX test-mode environment outside production may set 0.
# PAYOUT_ACCOUNT_COOLING_HOURS=24
# Partner Withdraw button. Off by default; when on, start with a low maximum. Amounts are paise.
# The first payout to a bank account, and any balance above the maximum, wait for Operations
# (Payouts > Withdrawals). Extra withdrawals beyond the free ones are refused while the fee is -1.
# Keep comments on their own lines: an inline comment after a value breaks parsing.
# PAYOUT_WITHDRAW_ENABLED=false
# PAYOUT_WITHDRAWAL_MIN_PAISE=10000
# PAYOUT_WITHDRAWAL_MAX_PAISE=2500000
# PAYOUT_WITHDRAWALS_PER_DAY=2
# PAYOUT_FREE_WITHDRAWALS_PER_WEEK=1
# PAYOUT_EXTRA_WITHDRAWAL_FEE_PAISE=-1

# --- Files: Cloudflare R2 (docs/runbooks/cloudflare-r2-storage.md) ---
DOCUMENT_STORAGE_PROVIDER=r2            # [R]
R2_ACCOUNT_ID=                          # [R]
R2_ACCESS_KEY_ID=                       # [R][S]
R2_SECRET_ACCESS_KEY=                   # [R][S]
R2_PUBLIC_BUCKET=vsolve-public          # [R]
R2_PUBLIC_BASE_URL=https://media.vsolvehub.com   # [R] https
R2_PRIVATE_BUCKET=vsolve-private        # [R] must differ from the public bucket

# --- Geocoding: Google turns a map pin into an address (production refuses anything else) ---
# The server key: Geocoding API and Routes API (the Partner app's route map, 1.96.0), restricted
# to this server's IP. Not the browser key and not the Android key.
GEOCODING_PROVIDER=google               # [R]
GOOGLE_MAPS_SERVER_KEY=                 # [R][S]
ROUTING_CACHE_SECONDS=60                # [O] one Routes API call a minute per Partner position

# --- Partner KYC documents: malware scanning ---
# Owner decision (October 2026): production runs without a malware scanner. "none" accepts every
# upload unscanned so Operations can open and approve it. "unconfigured" would keep every upload
# PENDING, and no partner could be approved. "development" is refused in production.
DOCUMENT_SCAN_PROVIDER=none             # [R] none | unconfigured

# --- Partner agreements ---
# The Partner site's origin. Each release publishes its /terms and /privacy pages as the
# agreements every applicant accepts; without them no application can be submitted.
PARTNER_LEGAL_BASE_URL=https://partner.vsolvehub.com   # [R] https

# --- OneSignal Web Push & Instant Job Dispatch ---
# One OneSignal app per audience, shared by its website and mobile app. There is no shared
# ONESIGNAL_APP_ID / ONESIGNAL_REST_API_KEY; production refuses to start without all four.
ONESIGNAL_PARTNER_APP_ID=a4b12340-473f-4349-a874-bd4d1128688e   # [R] Partner OneSignal app (partner website + partner app)
ONESIGNAL_PARTNER_REST_API_KEY=                                  # [R][S] Partner app REST API key (os_v2_app_...)
ONESIGNAL_CUSTOMER_APP_ID=6aa192fa-a225-4230-a65b-8119b598622d  # [R] Customer OneSignal app (customer website + customer app)
ONESIGNAL_CUSTOMER_REST_API_KEY=                                 # [R][S] Customer app REST API key (os_v2_app_...)
ONESIGNAL_PARTNER_OFFER_CHANNEL_ID=                              # [O] Partner app "Job offers" Android channel id (booking_alert sound)
ONESIGNAL_ENV=production                                         # [R] production
MOBILE_PUSH_PROVIDER=onesignal                                   # [R] the mobile apps receive push through OneSignal
DISPATCH_OFFER_EXPIRY_SECONDS=60                         # seconds before an instant offer expires
PARTNER_PORTAL_BASE_URL=https://partner.vsolvehub.com     # [R] partner portal origin for push notification deep links
FEATURE_PUSH_GATED_INSTANT=false                          # [R] enable shift + push-gated instant availability
PARTNER_SHIFT_DEFAULT_DURATION_HOURS=8                    # default partner shift duration
PARTNER_SHIFT_MAX_IDLE_MINUTES=30                         # safety idle timeout for inactive shifts
PARTNER_PRESENCE_BACKGROUND_TTL_SECONDS=7200              # [O] a phone Partner push can reach stays online this long unopened
PARTNER_MAX_CONSECUTIVE_MISSED_OFFERS=2                   # [O] lapsed offers in a row that take a Partner offline
CUSTOMER_SITE_URL=https://www.vsolvehub.com               # [O] customer site origin, for web push click-through
PARTNER_LOCATION_MAX_AGE_MINUTES=30                       # maximum age of partner location for instant matching
MAX_DISPATCH_ATTEMPTS=5                                   # maximum sequential candidate rotations
MAX_CONSECUTIVE_MISSED_OFFERS=3                           # missed offers before auto-pausing shift

# --- Must stay off in production (the settings refuse to start otherwise) ---
# OTP_DEVELOPMENT_CODE_ENABLED=false
# PAYMENTS_ALLOW_SIMULATED_CAPTURE=false
# NOTIFICATIONS_ALLOW_FAKE_TRANSPORT=false
# PAYOUTS_ALLOW_FAKE_PROVIDER=false
