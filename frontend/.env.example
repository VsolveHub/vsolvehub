# Browser-visible Django API origin. Must be CORS-permitted by Django.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-side Django API origin for Next.js rendering. In local development this
# usually matches NEXT_PUBLIC_API_BASE_URL; in Docker/staging it can be internal.
API_BASE_URL=http://localhost:8000

# Public site origin for metadata, robots and sitemaps.
# Use the app-specific origin when running one app locally:
#   customer: http://localhost:3000
#   partner:  http://localhost:3001
#   admin:    http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Use only when a test or story explicitly opts into MSW in-browser mocks.
# NEXT_PUBLIC_API_MOCKS=enabled

# Phone authentication provider: "firebase" | "otp" (default "otp")
NEXT_PUBLIC_PHONE_AUTH_PROVIDER=otp

# Firebase Client SDK configuration
# Firebase phone auth refuses pages served from `localhost`, even when it is an
# authorized domain (the send fails with auth/invalid-app-credential). To send a
# real SMS locally, open http://127.0.0.1:<port> and set NEXT_PUBLIC_API_BASE_URL
# empty so the dev proxy keeps the session cookie first-party: 127.0.0.1 and
# localhost are different sites, so a cross-site API origin loses the session.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Firebase App Check reCAPTCHA v3 site key
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

