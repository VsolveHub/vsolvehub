{
  "name": "vsolve-frontend",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "turbo run build",
    "contract:check": "pnpm --filter @vsolve/api-client generate:check",
    "contract:generate": "pnpm --filter @vsolve/api-client generate",
    "dev": "turbo run dev --filter=customer --filter=partner --filter=admin",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:customer": "turbo run dev --filter=customer",
    "dev:partner": "turbo run dev --filter=partner",
    "dev:mobile:partner": "pnpm --filter partner-mobile start",
    "dev:mobile:customer": "pnpm --filter customer-mobile start",
    "e2e": "playwright test",
    "e2e:build": "pnpm build && playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm contract:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "connect": "^3.7.0",
    "jsdom": "^29.1.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "expo-router": "~58.0.26"
  }
}
