# Local development: copy to .env.local. Production (Vercel, admin.vsolvehub.com):
# NEXT_PUBLIC_API_BASE_URL and API_BASE_URL = https://api.vsolvehub.com,
# NEXT_PUBLIC_SITE_URL = https://admin.vsolvehub.com.
# Operations sign in with a backend OTP (MSG91 in production), never Firebase, so this app
# has no Firebase keys. It has no dev proxy either: the browser always calls the API directly.

# Browser-visible Django API origin. Must be CORS-permitted by Django.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-side Django API origin for Next.js rendering.
API_BASE_URL=http://localhost:8000

# Public site origin for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
