# Local development: copy to .env.local. Production (Vercel, admin.vsolvehub.com):
# NEXT_PUBLIC_API_BASE_URL and API_BASE_URL = https://api.vsolvehub.com,
# NEXT_PUBLIC_SITE_URL = https://admin.vsolvehub.com, NEXT_PUBLIC_PHONE_AUTH_PROVIDER = firebase,
# and the four NEXT_PUBLIC_FIREBASE_* values (the same Firebase project as the other apps).
# This app has no dev proxy: the browser always calls the API directly.

# Browser-visible Django API origin. Must be CORS-permitted by Django.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-side Django API origin for Next.js rendering.
API_BASE_URL=http://localhost:8000

# Public site origin for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# How Operations sign in and confirm refunds: "firebase" | "otp" (default "otp").
# Keep "otp" locally: Django shows the development code on screen. Firebase refuses pages served
# from localhost, and 127.0.0.1 would put the session cookie on a different site from the API.
# Production uses "firebase" (or "otp" once MSG91 is set up on the backend).
NEXT_PUBLIC_PHONE_AUTH_PROVIDER=otp

# Firebase Client SDK configuration (only read when the provider is "firebase").
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
