# Job screen route map (Android). Set as an EAS secret, never in eas.json or git: a Maps SDK for
# Android key restricted to package com.vsolvehub.partner and the app's signing SHA-1. Without it
# the app keeps the address card and the Navigate button and draws no map.
# GOOGLE_MAPS_ANDROID_API_KEY=
