{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build",
        "generate:check"
      ]
    },
    "generate": {
      "cache": false
    },
    "generate:check": {
      "inputs": [
        "../contracts/openapi/v1.yaml",
        "src/generated/**",
        "scripts/**"
      ],
      "outputs": []
    }
  }
}
