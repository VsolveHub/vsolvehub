+
+    activate_premium_feature(payment_attempt_id=listing.payment_attempt.id)
+    listing.refresh_from_db()
+    assert listing.is_premium is True
+
+    activate_premium_feature(payment_attempt_id=listing.payment_attempt.id)
+    listing.refresh_from_db()
+    assert listing.is_premium is True
