# Copy to .env.local and fill in. NEVER put real credentials in this file (it is committed).

# ── Supabase Postgres (same vsolvehub-dev/-prod project + schema as partner/customer) ──
# Supabase → Project Settings → Database → Connection string → "Prisma".
# DATABASE_URL = pooled (port 6543). DIRECT_URL = direct/session (port 5432, migrations).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres"

# ── Supabase Auth (admin login only — magic link) ──
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# The "anon" / "publishable" key — safe to expose to the browser (RLS-scoped).
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
# The "service_role" key — SERVER-ONLY. Grants full DB + Storage access, bypasses RLS.
# Used solely to mint short-lived signed URLs for private KYC documents. Never expose client-side.
SUPABASE_SERVICE_KEY="ey..."

# Public site URL (used for the magic-link redirect + canonical links)
NEXT_PUBLIC_SITE_URL="https://admin.vsolvehub.com"
