# Copy to .env.local and fill in.
# Single Supabase Postgres database shared by all apps (customer / partner / admin).
# DATABASE_URL = pooled (Transaction pooler, port 6543). DIRECT_URL = direct (port 5432, migrations).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres"

# Secret for signing customer session cookies. Generate: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL (used for canonical links)
NEXT_PUBLIC_SITE_URL="https://vsolvehub.com"